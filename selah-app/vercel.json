{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/noon-setlists",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/reminders",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
